{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 41,
  "border-radius": 25,
  "margin-right": 10,
  "margin-left": 10,
  "margin-top": 2,
  "modules-left": ["custom/cristos-launcher", "custom/active_window", "custom/separator#dot", "cpu", "memory", "custom/media"],
  "modules-center": [ "hyprland/workspaces" ],
  "modules-right": [
    "clock",
    "custom/separator#dot",
    "custom/idle-indicator",
    "custom/notifications",
    "custom/screenrecording-indicator",
    "custom/update",
    "group/tray-expander",
    "custom/controlcenter",
  ],

// GROUPS MODULE




// MODULES

  "custom/active_window": {
    "exec": "~/.config/waybar/window.sh",
    "return-type": "json",
    "restart-interval": 2,
    "markup": true
  },
  
  "hyprland/workspaces": {
	  "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
          "default": "",
          "active": "",
          "empty": "",
        },
      "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": [],
    },
	},

  "custom/cristos-launcher": {
    "format": "<span size='11500'></span>",
    "on-click": "~/.config/hypr/scripts/launcher.sh >/dev/null 2>&1",
    "on-click-right": "~/.config/rofi/powermenu/powermenu.sh",
    "tooltip-format": "Aplicaciones · Super + D\nClic derecho: menú de energía"
  },

"cpu": {
  "interval": 2,
  "format": "󰻠 {icon}",
  "tooltip-format": "CPU: {usage}%",
  "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
  "on-click": "~/.config/waybar/scripts/glassy-system.sh btop"
},

"memory": {
  "interval": 2,
  "format": " {icon}",
  "tooltip-format": "RAM: {percentage}% ({used}/{total})",
  "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
  "on-click": "~/.config/waybar/scripts/glassy-system.sh btop"
},

"clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:L%A, %d %B %Y}",
    "tooltip-format": "<big>{:L%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
},




  
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 180,
      "children-class": "tray-group-item",
      "transition-left-to-right": false
    },
    "modules": ["custom/expand-icon", "tray"]
  },

  "custom/expand-icon": {
    "format": "󰅂",
    "tooltip-format": "Aplicaciones en segundo plano"
  },

  "custom/screenrecording-indicator": {
    "on-click": "~/.config/hypr/scripts/record.sh full",
    "exec": "~/.config/waybar/scripts/glassy-system.sh recording-status",
    "signal": 8,
    "interval": 2,
    "return-type": "json"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

"custom/media": {
  "exec": "status=$(playerctl status 2>/dev/null); title=$(playerctl metadata title 2>/dev/null); artist=$(playerctl metadata artist 2>/dev/null); if [ \"$status\" = \"Playing\" ] && [ -n \"$title\" ]; then short=\"${title:0:24}\"; [ ${#title} -gt 24 ] && short=\"$short…\"; full=\"$title\"; [ -n \"$artist\" ] && full=\"$artist — $title\"; jq -nc --arg text \"  $short \" --arg tooltip \"$full\" '{text:$text, tooltip:$tooltip, class:\"playing\"}'; else printf '{\"text\":\"\"}\n'; fi",
  "return-type": "json",
  "escape": true,
  "interval": 2,
  "on-click": "playerctl play-pause",
  "on-click-right": "playerctl next",
  "on-scroll-up": "playerctl previous",
  "on-scroll-down": "playerctl next"
},

  "custom/separator#blank": {
	  "format": " ",
	  "interval": "once",
	  "tooltip": false
},

  "custom/separator#dot": {
	  "format": " ",
	  "interval": "once",
	  "tooltip": false
},

  "custom/idle-indicator": {
    "on-click": "~/.config/hypr/scripts/caffeine.sh toggle",
    "exec": "~/.config/waybar/scripts/glassy-system.sh idle-status",
    "signal": 9,
    "interval": 2,
    "return-type": "json"
  },
  
  "custom/notification-silencing-indicator": {
    "on-click": "~/.config/hypr/scripts/notifications.sh toggle",
    "exec": "~/.config/waybar/scripts/glassy-system.sh dnd-status",
    "signal": 10,
    "interval": 2,
    "return-type": "json"
  },

  "custom/notifications": {
    "exec": "~/.config/hypr/scripts/notifications.sh waybar",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.config/hypr/scripts/notifications.sh notifications",
    "on-click-right": "~/.config/hypr/scripts/notifications.sh toggle"
  },

  "custom/update": {
    "format": "",
    "exec": "~/.config/waybar/scripts/glassy-system.sh updates",
    "on-click": "~/.config/waybar/scripts/glassy-system.sh update-open",
    "tooltip-format": "{text}\nCachyOS · clic para actualizar (paru)",
    "signal": 7,
    "interval": 21600
  },


  "custom/controlcenter": {
    "format": "󰒓",
    "tooltip-format": "Centro de control\nClic: abrir · Rueda: volumen",
    "tooltip": true,
    "on-click": "~/.config/hypr/scripts/control-center.sh",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower"
  },

}
