DAYS=$((UPTIME/86400))
HOURS=$(( (UPTIME%86400)/3600 ))
MINS=$(( (UPTIME%3600)/60 ))

if [ "$DAYS" -gt 0 ]; then
    UPTIME_STR="${DAYS}d ${HOURS}h"
else
    UPTIME_STR="${HOURS}h ${MINS}m"
fi

# ---- OUTPUT ----
case "$STATE" in
    0)
        echo "[CPU $CPU%]"
        ;;
    1)
        echo "[MEM $MEM%]"
        ;;
    2)
        echo "[LOAD $LOAD]"
        ;;
    3)
        [ -n "$TEMP" ] && echo "[TEMP ${TEMP}°C]" || echo "[TEMP N/A]"
        ;;
    4)
        echo "[UP $UPTIME_STR]"
        ;;
esac
</file>

