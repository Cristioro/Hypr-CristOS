@import "~/.config/rofi/colors.rasi"

/*****----- Configuration -----*****/
configuration {
    show-icons: false;
}

/*****----- Global Properties -----*****/
* {
    background-alt:   rgba(0, 0, 0, 0.6);
    selected:     @color1;
    active:       @color3;
    urgent:       @color7;
}

/*****----- Main Window -----*****/
window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 300px;
    x-offset: 0px;
    y-offset: 0px;

    border: 4px;
    border-radius: 7px;
    border-color: @color1;

    background-color: @background-alt;
}

/*****----- Main Box -----*****/
mainbox {
    enabled: true;
    spacing: 2px;
    padding: 2px;
    background-color: @background-alt;
    children: [ "listview" ];
}



/*****----- Inputbar -----*****/
inputbar {
    enabled: true;
    background-color: @background-alt;
    text-color: @foreground;
    children: ["dummy", "prompt"];
}

prompt {
    enabled: true;
    padding: 4px;
    border-radius: 4px;
    background-color: @background-alt;
    text-color: @foreground;
}

/*****----- Listview -----*****/
listview {
    enabled: true;
    columns: 1;
    lines: 6;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;

    spacing: 4px;
    padding: 4px;
    background-color: @background-alt;
}

/*****----- Elements (Text Instead of Icons) -----*****/
element {
    enabled: true;
    padding: 10px;
    border-radius: 2px;
    background-color: @background-alt;
    text-color: @color1;
    cursor: pointer;
}

element selected.normal {
    background-color: @selected;
    text-color: @background;
}

element-text {
    font: "Iosevka Nerd Font 10";
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
}

/*****----- Message Box -----*****/
message {
    enabled: true;
    margin: 2px;
    padding: 4px;
    border-radius: 2px;
    background-color: @background-alt;
    text-color: @foreground;
}

textbox {
    background-color: transparent;
    text-color: @foreground;
}
