* {
    /* Material You base roles */
    primary: #ffb3b3;
    primary-fixed: #ffdad9;
    primary-fixed-dim: #ffb3b3;
    on-primary: #561d20;
    on-primary-fixed: #3b080d;
    on-primary-fixed-variant: #733335;
    primary-container: #733335;
    on-primary-container: #ffdad9;
    secondary: #e6bdbc;
    secondary-fixed: #ffdad9;
    secondary-fixed-dim: #e6bdbc;
    on-secondary: #442929;
    on-secondary-fixed: #2c1515;
    on-secondary-fixed-variant: #5d3f3f;
    secondary-container: #5d3f3f;
    on-secondary-container: #ffdad9;
    tertiary: #e5c18d;
    tertiary-fixed: #ffddae;
    tertiary-fixed-dim: #e5c18d;
    on-tertiary: #422c05;
    on-tertiary-fixed: #281800;
    on-tertiary-fixed-variant: #5b421a;
    tertiary-container: #5b421a;
    on-tertiary-container: #ffddae;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #1a1111;
    on-surface: #f0dede;
    on-surface-variant: #d7c1c1;
    outline: #a08c8c;
    outline-variant: #524343;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f0dede;
    inverse-on-surface: #382e2e;
    inverse-primary: #8f4a4c;
    surface-dim: #1a1111;
    surface-bright: #423736;
    surface-container-lowest: #140c0c;
    surface-container-low: #221919;
    surface-container: #271d1d;
    surface-container-high: #322827;
    surface-container-highest: #3d3232;

    /* Mapeo para compatibilidad con variables antiguas (Base16) */
    background: @surface;
    foreground: @on-surface;
    color0: @surface-dim;
    color1: @on-primary;
    color2: @secondary;
    color3: @tertiary;
    color4: @primary-container;
    color5: @primary-fixed;
    color6: @secondary-fixed;
    color7: @on-surface-variant;
    color8: @outline-variant;
    color9: @error;
    color10: @secondary-container;
    color11: @tertiary-container;
    color12: @primary-container; /* reutilizado */
    color13: @on-primary;
    color14: @on-secondary;
    color15: @on-tertiary;
}